# 이 파일은 키 목록 문서다. 실제 값은 .env.local / .env.prd 에 들어간다.
#
#   .env.local   로컬 개발 — `pnpm dev` 가 자동으로 읽는다
#   .env.prd     배포      — `docker run --env-file`
#
# 둘 다 gitignore 되어 있다. 커밋하지 않는다.

# 세션 쿠키 서명 키 (32자 이상) — openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# 로그인 비밀번호 scrypt 해시 — printf '%s' '<비밀번호>' | node scripts/hash-password.mjs
# 평문은 절대 넣지 않는다.
NUXT_ADMIN_PASSWORD_HASH=

# memos/ 가 이 아래에 생긴다
NUXT_DATA_DIR=./data

# 이 앱의 바깥 주소. 구글 일정 설명에 메모 링크로 넣는다. 비우면 링크 없음
NUXT_SITE_URL=

# ── 구글 캘린더 연동 (설계문서 §8) ──────────────────────────────────────
# 캘린더 ID 와 키(둘 중 하나)가 다 있어야 켜진다. 비우면 꺼진다 — 개발 기본값은 꺼짐.
# 🔴 .env.local 에 운영 「메모」 캘린더를 넣지 않는다. 대조는 이 서버가 모르는 메모의 일정을 지우므로
#    개발·운영이 한 캘린더를 나눠 쓰면 서로의 일정을 지운다. 개발에서 시험하려면 따로 만든 캘린더를 쓴다.
NUXT_GOOGLE_CALENDAR_ID=
# 운영: 키 JSON 을 base64 로 — base64 -i <키 파일> | tr -d '\n'
NUXT_GOOGLE_SERVICE_ACCOUNT=
# 개발: 키 파일 경로
NUXT_GOOGLE_SERVICE_ACCOUNT_FILE=

# 개발 전용 — 로그인 비밀번호 평문. 자동 시험(scripts/calendar-smoke 등)이 로그인할 때 쓴다.
# .env.local 에만 둔다. 운영 .env.prd 에는 넣지 않는다.
E2E_PASSWORD=
