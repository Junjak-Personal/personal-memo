<?xml version="1.0" encoding="UTF-8"?>
<!--
  메모 오프사이트 백업 pull, 맥에서 매일 실행. ops/memo-offsite-pull.sh 를 부른다.

  설치:
    mkdir -p ~/memo-backups
    cp ops/win.jun-devlog.memo.offsite-pull.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/win.jun-devlog.memo.offsite-pull.plist
    launchctl start win.jun-devlog.memo.offsite-pull        # 즉시 1회 실행해 검증
  제거:
    launchctl unload ~/Library/LaunchAgents/win.jun-devlog.memo.offsite-pull.plist

  ⚠ ProgramArguments 의 경로는 이 저장소의 체크아웃 위치에 묶여 있다. 저장소를 옮기면
    이 파일도 같이 고칠 것 — launchd 는 없는 경로를 조용히 실패로 처리한다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>win.jun-devlog.memo.offsite-pull</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jun/develop/personal/personal-memo/ops/memo-offsite-pull.sh</string>
  </array>

  <!-- 06:40 KST. 박스는 19:30 UTC(+지터) = 04:3x KST 에 백업하므로 두 시간 뒤다.
       launchd 는 맥이 자고 있어 놓친 실행을 깨어날 때 따라잡는다. nivoca pull(06:30)과 10분 띄운다. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>40</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- 실패를 볼 수 있어야 한다. 조용히 실패하는 백업은 백업이 없는 것보다 나쁘다. -->
  <key>StandardOutPath</key>
  <string>/Users/jun/memo-backups/offsite-pull.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jun/memo-backups/offsite-pull.log</string>
</dict>
</plist>
