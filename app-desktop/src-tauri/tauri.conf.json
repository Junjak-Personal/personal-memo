{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memo",
  "version": "0.1.0",
  "identifier": "win.jundevlog.memo.desktop",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "개인 메모 데스크톱 앱",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  }
}
